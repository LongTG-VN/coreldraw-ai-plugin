# Optional local training environment variables.
# Copy to a non-committed file if needed.

# Hugging Face cache location. Put this on a drive with enough free space.
HF_HOME=D:\\ai-cache\\huggingface

# Optional token for gated models/datasets. Never commit the real value.
HUGGINGFACE_TOKEN=

# Optional override for future training wrappers.
DESIGN_TRAINING_PROFILE=smoke
